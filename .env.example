SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
HOST=127.0.0.1
PORT=8080
WAITRESS_THREADS=8
MAX_CONTENT_LENGTH=2097152

# --------------------------------------------------------------------
# اتصال به SQL Server
# --------------------------------------------------------------------
# نام/آدرس سرور (مثال: localhost یا 192.168.1.10 یا myserver.database.windows.net)
MSSQL_SERVER=localhost
# اگر SQL Server روی پورت غیر پیش‌فرض است (پیش‌فرض 1433 نیازی به تنظیم ندارد)
MSSQL_PORT=
# نام دیتابیس (همان که فایل repair_sqlserver.sql در آن اجرا شد)
MSSQL_DATABASE=repair
# نام درایور ODBC نصب‌شده روی این سرور — با: odbcinst -q -d  می‌توانید ببینید چه درایورهایی نصب است
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
# اگر می‌خواهید با کاربری/رمز SQL Server وصل شوید (MSSQL_TRUSTED_CONNECTION=0)
MSSQL_UID=sa
MSSQL_PWD=CHANGE_THIS_PASSWORD
# اگر روی ویندوز با Windows Authentication وصل می‌شوید، این را 1 کنید
# (در این حالت MSSQL_UID/MSSQL_PWD نادیده گرفته می‌شوند)
MSSQL_TRUSTED_CONNECTION=0
# برای درایور 18 معمولاً باید yes باشد. اگر سرور شما گواهی SSL معتبر عمومی ندارد
# (مثل اکثر سرورهای داخلی شرکت)، TrustServerCertificate را هم yes نگه دارید.
MSSQL_ENCRYPT=yes
MSSQL_TRUST_SERVER_CERTIFICATE=yes
